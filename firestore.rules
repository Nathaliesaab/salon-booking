rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Whoever runs the salon. Two ways to be listed, either is enough:
    //   1. a UID in this list -- edit and redeploy to change it
    //   2. a document in /admins whose ID is the UID
    // The list avoids depending on the Firestore console's collection dialog,
    // which is easy to get wrong. To hand the app over, add her UID here and
    // run: firebase deploy --only firestore:rules
    function isStylist() {
      return signedIn() && (
        request.auth.uid in [
          'iWQNUCAxpATuCIDqMLIgw7q79ru1'
        ]
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Optional second way to name a stylist. Only editable from the console.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Public read so the booking page can render services and hours.
    match /services/{id}   { allow read: if true; allow write: if isStylist(); }
    match /settings/{id}   { allow read: if true; allow write: if isStylist(); }
    match /blackouts/{id}  { allow read: if true; allow write: if isStylist(); }

    // Slot occupancy with no personal data -- safe to expose so clients can
    // see what is taken without seeing who took it.
    match /busy/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp
        && request.resource.data.start < request.resource.data.end;
      allow update, delete: if isStylist();
    }

    // Guest reviews. Anyone may read them; a signed-in guest may post one
    // under their own UID but may never edit or delete it afterwards -- only
    // the stylist can hide or remove a review, so nobody can quietly rewrite
    // a five-star post into something else after it is published.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isStylist();
    }

    // Names, phones, and notes. Readable only by the stylist and by whoever
    // created the request.
    match /appointments/{id} {
      allow read: if isStylist() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientName.size() < 120
        && request.resource.data.clientPhone.size() < 40
        && request.resource.data.notes.size() < 500
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp
        && request.resource.data.start < request.resource.data.end;
      allow update, delete: if isStylist();
    }
  }
}
